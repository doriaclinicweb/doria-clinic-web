---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import clinica from '../data/clinica.json';
import { imagenPorDefecto } from '../data/imagenes';

interface Props {
  titulo: string;
  descripcion: string;
  noindex?: boolean;
  schema?: object;
  h1: string;
  lede?: string;
  migas?: { href: string; etiqueta: string }[];
  imagen?: string;
  anchoCompleto?: boolean;
}
const {
  titulo,
  descripcion,
  noindex = false,
  schema,
  h1,
  lede,
  migas = [],
  imagen = imagenPorDefecto,
  anchoCompleto = false,
} = Astro.props;

const pathname = Astro.url.pathname;
const esCa = pathname === '/ca' || pathname.startsWith('/ca/');
const idioma = esCa ? 'ca' : 'es';
const inicioHref = esCa ? '/ca/' : '/';
const inicioLabel = esCa ? 'Inici' : 'Inicio';

const esPath = (esCa ? pathname.replace(/^\/ca/, '') : pathname) || '/';
const caPath = esCa ? pathname : '/ca' + pathname;

const url = new URL(pathname, Astro.site);

const trail = [{ href: inicioHref, etiqueta: inicioLabel }, ...migas, { href: pathname, etiqueta: h1 }];
const schemaMigas = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((m, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: m.etiqueta,
    item: new URL(m.href, Astro.site).toString(),
  })),
};
---
<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="es" href={new URL(esPath, Astro.site)} />
    <link rel="alternate" hreflang="ca" href={new URL(caPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(esPath, Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={idioma === 'ca' ? 'ca_ES' : 'es_ES'} />
    <meta property="og:site_name" content={clinica.nombre} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagen} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagen} />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <script type="application/ld+json" set:html={JSON.stringify(schemaMigas)} />
  </head>
  <body>
    <Header />

    <section class="pagina-intro">
      <div class="wrap">
        <nav class="migas" aria-label="Migas de pan">
          <a href={inicioHref}>{inicioLabel}</a>
          {migas.map((m) => (
            <>
              <span class="separador">/</span>
              <a href={m.href}>{m.etiqueta}</a>
            </>
          ))}
          <span class="separador">/</span>
          <span class="actual" aria-current="page">{h1}</span>
        </nav>
        <h1>{h1}</h1>
        {lede && <p class="lede">{lede}</p>}
      </div>
    </section>

    <main class:list={['wrap', 'contenido', { 'contenido-ancho': anchoCompleto }]}>
      <slot />
    </main>

    <Footer />
  </body>
</html>
