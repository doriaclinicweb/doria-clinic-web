---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import clinica from '../data/clinica.json';
import { imagenPorDefecto } from '../data/imagenes';
import { detectarIdioma, rutaEn, inicioDe } from '../utils/idioma';

interface Props {
  titulo: string;
  descripcion: string;
  noindex?: boolean;
  schema?: object;
  h1: string;
  lede?: string;
  migas?: { href: string; etiqueta: string }[];
  imagen?: string;
  imagenCabecera?: { src: string; alt: string };
  anchoCompleto?: boolean;
  anchoDoble?: boolean;
  introDosColumnas?: boolean;
}
const {
  titulo,
  descripcion,
  noindex = false,
  schema,
  h1,
  lede,
  migas = [],
  imagenCabecera,
  imagen = imagenCabecera?.src || imagenPorDefecto,
  anchoCompleto = false,
  anchoDoble = false,
  introDosColumnas = false,
} = Astro.props;

const pathname = Astro.url.pathname;
const idioma = detectarIdioma(pathname);
const inicioHref = inicioDe(idioma);
const inicioLabel = { es: 'Inicio', ca: 'Inici', en: 'Home' }[idioma];

const esPath = rutaEn(pathname, 'es');
const caPath = rutaEn(pathname, 'ca');
const enPath = rutaEn(pathname, 'en');

const url = new URL(pathname, Astro.site);

const trail = [{ href: inicioHref, etiqueta: inicioLabel }, ...migas, { href: pathname, etiqueta: h1 }];
const schemaMigas = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((m, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: m.etiqueta,
    item: new URL(m.href, Astro.site).toString(),
  })),
};
---
<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={descripcion} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="es" href={new URL(esPath, Astro.site)} />
    <link rel="alternate" hreflang="ca" href={new URL(caPath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(esPath, Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={{ es: 'es_ES', ca: 'ca_ES', en: 'en_US' }[idioma]} />
    <meta property="og:site_name" content={clinica.nombre} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagen} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagen} />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <script type="application/ld+json" set:html={JSON.stringify(schemaMigas)} />
  </head>
  <body>
    <Header variante={imagenCabecera ? 'hero' : 'solida'} />

    <section class:list={['pagina-intro', { 'pagina-intro-imagen': !!imagenCabecera }]}>
      {imagenCabecera && <img class="pagina-intro-fondo" src={imagenCabecera.src} alt={imagenCabecera.alt} />}
      <div class="wrap">
        {introDosColumnas ? (
          <div class="pagina-intro-cuerpo">
            <div class="pagina-intro-texto">
              <nav class="migas" aria-label={{ es: 'Migas de pan', ca: 'Molles de pa', en: 'Breadcrumb' }[idioma]}>
                <a href={inicioHref}>{inicioLabel}</a>
                {migas.map((m) => (
                  <>
                    <span class="separador">/</span>
                    <a href={m.href}>{m.etiqueta}</a>
                  </>
                ))}
                <span class="separador">/</span>
                <span class="actual" aria-current="page">{h1}</span>
              </nav>
              <h1>{h1}</h1>
              {lede && <p class="lede">{lede}</p>}
              <slot name="intro-acciones" />
            </div>
            <slot name="intro-razones" />
          </div>
        ) : (
          <>
            <nav class="migas" aria-label={{ es: 'Migas de pan', ca: 'Molles de pa', en: 'Breadcrumb' }[idioma]}>
              <a href={inicioHref}>{inicioLabel}</a>
              {migas.map((m) => (
                <>
                  <span class="separador">/</span>
                  <a href={m.href}>{m.etiqueta}</a>
                </>
              ))}
              <span class="separador">/</span>
              <span class="actual" aria-current="page">{h1}</span>
            </nav>
            <h1>{h1}</h1>
            {lede && <p class="lede">{lede}</p>}
            <slot name="intro-extra" />
          </>
        )}
      </div>
    </section>

    <main class:list={['wrap', 'contenido', { 'contenido-ancho': anchoCompleto, 'contenido-doble': anchoDoble, 'contenido-seguido': Astro.slots.has('despues-contenido') }]}>
      <slot />
    </main>

    <div class="despues-contenido">
      <slot name="despues-contenido" />
    </div>

    <Footer />
    <CookieBanner idioma={idioma} />
  </body>
</html>
