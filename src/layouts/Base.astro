---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  titulo: string;
  descripcion: string;
  noindex?: boolean;
  schema?: object;
  h1: string;
  lede?: string;
  migas?: { href: string; etiqueta: string };
}
const { titulo, descripcion, noindex = false, schema, h1, lede, migas } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <Header />

    <section class="pagina-intro">
      <div class="wrap">
        {migas && <a class="migas" href={migas.href}>← {migas.etiqueta}</a>}
        <h1>{h1}</h1>
        {lede && <p class="lede">{lede}</p>}
      </div>
    </section>

    <main class="wrap contenido">
      <slot />
    </main>

    <Footer />
  </body>
</html>
