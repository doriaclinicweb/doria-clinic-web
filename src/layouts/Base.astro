---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import clinica from '../data/clinica.json';
import { imagenPorDefecto } from '../data/imagenes';

interface Props {
  titulo: string;
  descripcion: string;
  noindex?: boolean;
  schema?: object;
  h1: string;
  lede?: string;
  migas?: { href: string; etiqueta: string };
  imagen?: string;
}
const {
  titulo,
  descripcion,
  noindex = false,
  schema,
  h1,
  lede,
  migas,
  imagen = imagenPorDefecto,
} = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={url} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={clinica.nombre} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagen} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagen} />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <Header />

    <section class="pagina-intro">
      <div class="wrap">
        {migas && <a class="migas" href={migas.href}>← {migas.etiqueta}</a>}
        <h1>{h1}</h1>
        {lede && <p class="lede">{lede}</p>}
      </div>
    </section>

    <main class="wrap contenido">
      <slot />
    </main>

    <Footer />
  </body>
</html>
