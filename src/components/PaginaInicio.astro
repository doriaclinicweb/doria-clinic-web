---
import { getCollection, getEntry } from 'astro:content';
import '../styles/global.css';
import clinica from '../data/clinica.json';
import Header from './Header.astro';
import Footer from './Footer.astro';
import EquipoModulo from './EquipoModulo.astro';
import type { Idioma } from '../utils/idioma';
import { inicioDe } from '../utils/idioma';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;

const home = await getEntry('home', idioma);
if (!home) throw new Error(`Falta src/content/home/${idioma}.md`);
const d = home.data;

const prefijo = idioma === 'es' ? '' : '/' + idioma;
const base = inicioDe(idioma);
const canonical = `https://doria.clinic${base}`;

const especialidades = (await getCollection('especialidades', (e) => e.data.idioma === idioma && e.data.mostrar_en_home))
  .sort((a, b) => a.data.orden - b.data.orden);
const urlEsp = (e) =>
  `${prefijo}/especialidades/${e.id.replace(new RegExp('^' + idioma + '/'), '')}/`;

const verTodas = { es: 'Todas las especialidades', ca: 'Totes les especialitats', en: 'All specialties' }[idioma];
const textoGratis = { es: '100% gratuita', ca: '100% gratuïta', en: '100% free' }[idioma];

const wa = clinica.software_citas;
const tel = 'tel:' + clinica.telefono.replace(/\s/g, '');

const puntos = d.primera_visita_puntos.map((p) =>
  p.replace('{telefono_urgencias}', clinica.telefono_urgencias).replace('{telefono}', clinica.telefono)
);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: clinica.nombre,
  telephone: clinica.telefono,
  email: clinica.email,
  url: 'https://doria.clinic',
  address: {
    '@type': 'PostalAddress',
    streetAddress: clinica.direccion.calle,
    postalCode: clinica.direccion.codigo_postal,
    addressLocality: clinica.direccion.ciudad,
    addressCountry: 'ES',
  },
  openingHours: 'Mo-Fr 10:00-14:00, Mo-Fr 16:00-20:00',
  medicalSpecialty: 'Dentistry',
};
---
<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{d.seo.titulo_seo}</title>
    <meta name="description" content={d.seo.meta_descripcion} />
    {d.seo.noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href="https://doria.clinic/" />
    <link rel="alternate" hreflang="ca" href="https://doria.clinic/ca/" />
    <link rel="alternate" hreflang="en" href="https://doria.clinic/en/" />
    <link rel="alternate" hreflang="x-default" href="https://doria.clinic/" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={{ es: 'es_ES', ca: 'ca_ES', en: 'en_US' }[idioma]} />
    <meta property="og:site_name" content={clinica.nombre} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={d.seo.titulo_seo} />
    <meta property="og:description" content={d.seo.meta_descripcion} />
    <meta property="og:image" content={`https://doria.clinic${d.hero_imagenes[0].src}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={d.seo.titulo_seo} />
    <meta name="twitter:description" content={d.seo.meta_descripcion} />
    <meta name="twitter:image" content={`https://doria.clinic${d.hero_imagenes[0].src}`} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <Header variante="hero" />

    <section class="hero">
      <div class="hero-slider" data-intervalo="4500">
        <div class="pista">
          {d.hero_imagenes.map((img, i) => (
            <img
              src={img.src}
              alt={img.alt}
              loading={i === 0 ? undefined : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
            />
          ))}
          {d.hero_imagenes.length > 1 && (
            <img src={d.hero_imagenes[0].src} alt="" aria-hidden="true" loading="lazy" />
          )}
        </div>
      </div>
      <div class="wrap">
        <h1>{d.hero_titular}</h1>
        <p class="entradilla">{d.hero_entradilla}</p>
        <div class="acciones">
          <a class="boton boton-primario" href={wa} target="_blank" rel="noopener noreferrer">{d.cta_texto}</a>
          <a class="boton boton-fantasma" href={tel}>{clinica.telefono}</a>
        </div>
      </div>
    </section>

    <section class="seccion intro">
      <div class="wrap cuerpo">
        <p>{d.intro_frase}</p>
        <div>
          {d.intro_parrafos.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <EquipoModulo idioma={idioma} titulo={d.equipo_titulo} />

    <section class="seccion elegirnos">
      <div class="wrap">
        <h2>{d.elegirnos_titulo}</h2>
        <div class="elegirnos-lista">
          {d.elegirnos.map((r) => (
            <div>
              <h3>{r.titulo}</h3>
              <p>{r.texto}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="seccion" id="tratamientos">
      <div class="wrap">
        <div class="encabezado-tratamientos">
          <h2>{d.tratamientos_titulo}</h2>
          <a class="ver-todas" href={`${prefijo}/especialidades/`}>{verTodas} →</a>
        </div>
        <div class="carrusel-tratamientos">
          <div class="carrusel-pista">
            {especialidades.map((e) => (
              <a href={urlEsp(e)} class="tratamiento">
                <span class="tratamiento-titulo">{e.data.titulo}</span>
                <div class="tratamiento-cuerpo">
                  {e.data.icono && <img class="tratamiento-icono" src={e.data.icono} alt="" loading="lazy" />}
                  <p>{e.data.resumen_corto || e.data.resumen}</p>
                </div>
              </a>
            ))}
          </div>
          <button type="button" class="carrusel-flecha anterior" data-dir="-1" aria-label="Anterior"></button>
          <button type="button" class="carrusel-flecha siguiente" data-dir="1" aria-label="Siguiente"></button>
        </div>
      </div>
    </section>

    <section class="seccion visita">
      <div class="wrap cuerpo">
        <div>
          {clinica.primera_visita_gratuita && <span class="insignia-gratis">{textoGratis}</span>}
          <h2>{d.primera_visita_titulo}</h2>
          <p>{d.primera_visita_texto}</p>
          <div class="acciones" style="margin-top:2rem">
            <a class="boton boton-primario" href={wa} target="_blank" rel="noopener noreferrer">{d.primera_visita_cta}</a>
          </div>
        </div>
        <ul>
          {puntos.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </section>

    <section class="seccion" id="espacio">
      <div class="wrap">
        <h2>{d.instalaciones_titulo}</h2>
        <p style="margin-bottom:2.5rem">{d.instalaciones_texto}</p>
        <div class="espacio">
          <div class="espacio-pista">
            {[...d.instalaciones_imagenes, ...d.instalaciones_imagenes].map((img, i) => (
              i < d.instalaciones_imagenes.length
                ? <img src={img.src} alt={img.alt} loading="lazy" />
                : <img src={img.src} alt="" aria-hidden="true" loading="lazy" />
            ))}
          </div>
        </div>
      </div>
    </section>

    {d.opiniones.length > 0 && (
      <section class="seccion" style="background:var(--gris)">
        <div class="wrap">
          <h2>{d.opiniones_titulo}</h2>
          <div class="opiniones">
            {d.opiniones.map((o) => (
              <blockquote>
                <q>{o.texto}</q>
                <cite>{o.autor}</cite>
              </blockquote>
            ))}
          </div>
        </div>
      </section>
    )}

    <Footer />

    <script>
      // Carrusel de tratamientos: las flechas desplazan la pista una tarjeta
      // (más el hueco) cada vez. Se deshabilitan solas al llegar a un extremo.
      document.querySelectorAll<HTMLElement>('.carrusel-tratamientos').forEach((carrusel) => {
        const pista = carrusel.querySelector<HTMLElement>('.carrusel-pista');
        const anterior = carrusel.querySelector<HTMLButtonElement>('.carrusel-flecha.anterior');
        const siguiente = carrusel.querySelector<HTMLButtonElement>('.carrusel-flecha.siguiente');
        if (!pista || !anterior || !siguiente) return;

        const actualizarFlechas = () => {
          const maximo = pista.scrollWidth - pista.clientWidth - 1;
          anterior.disabled = pista.scrollLeft <= 0;
          siguiente.disabled = pista.scrollLeft >= maximo;
        };

        const desplazar = (dir: number) => {
          const tarjeta = pista.querySelector<HTMLElement>('.tratamiento');
          const paso = tarjeta ? tarjeta.getBoundingClientRect().width + parseFloat(getComputedStyle(pista).gap || '0') : pista.clientWidth;
          pista.scrollBy({ left: dir * paso, behavior: 'smooth' });
        };

        anterior.addEventListener('click', () => desplazar(-1));
        siguiente.addEventListener('click', () => desplazar(1));
        pista.addEventListener('scroll', actualizarFlechas, { passive: true });
        window.addEventListener('resize', actualizarFlechas);
        actualizarFlechas();
      });

      // Slider de fotos del hero: avanza sola, en bucle, sin flechas ni puntos.
      // El último elemento de la pista es un clon de la primera foto: al
      // llegar a él, saltamos sin transición de vuelta al principio, con lo
      // que el bucle se ve continuo.
      document.querySelectorAll<HTMLElement>('.hero-slider').forEach((slider) => {
        const pista = slider.querySelector<HTMLElement>('.pista');
        if (!pista || pista.children.length <= 2) return; // 1 foto real + su clon: no hace falta animar
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const fotosReales = pista.children.length - 1; // sin contar el clon
        const intervalo = Number(slider.dataset.intervalo) || 4500;
        let actual = 0; // siempre 0..fotosReales-1: con módulo, nunca puede salirse de rango

        setInterval(() => {
          const siguiente = (actual + 1) % fotosReales;
          if (siguiente === 0) {
            // Vuelta al principio: deslizamos hasta el clon (una posición más
            // allá de la última foto real) y, pasada la transición (300ms, ver
            // .hero-slider .pista en global.css), saltamos sin animación a la
            // primera foto. Temporizador fijo, no "transitionend": así el
            // bucle nunca se queda colgado si el navegador no llega a
            // disparar el evento.
            pista.style.transform = `translateX(-${fotosReales * 100}%)`;
            setTimeout(() => {
              pista.style.transition = 'none';
              pista.style.transform = 'translateX(0%)';
              void pista.offsetWidth;
              pista.style.transition = '';
            }, 320);
          } else {
            pista.style.transform = `translateX(-${siguiente * 100}%)`;
          }
          actual = siguiente;
        }, intervalo);
      });
    </script>
  </body>
</html>
