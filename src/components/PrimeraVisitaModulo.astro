---
import clinica from '../data/clinica.json';
import type { Idioma } from '../utils/idioma';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;

const pv = clinica.primera_visita;
const titulo = idioma === 'ca' ? pv.titulo_ca : idioma === 'en' ? pv.titulo_en : pv.titulo;
const texto = idioma === 'ca' ? pv.texto_ca : idioma === 'en' ? pv.texto_en : pv.texto;
const cta = idioma === 'ca' ? pv.cta_ca : idioma === 'en' ? pv.cta_en : pv.cta;
const puntos = (idioma === 'ca' ? pv.puntos_ca : idioma === 'en' ? pv.puntos_en : pv.puntos).map((p: string) =>
  p.replace('{telefono_urgencias}', clinica.telefono_urgencias).replace('{telefono}', clinica.telefono)
);
const textoGratis = { es: '100% gratuita', ca: '100% gratuïta', en: '100% free' }[idioma];
const wa = clinica.software_citas;
---
<section class="seccion visita">
  <div class="wrap cuerpo">
    <div>
      {clinica.primera_visita_gratuita && <span class="insignia-gratis">{textoGratis}</span>}
      <h2>{titulo}</h2>
      <p>{texto}</p>
      <div class="acciones" style="margin-top:2rem">
        <a class="boton boton-primario" href={wa} target="_blank" rel="noopener noreferrer">{cta}</a>
      </div>
    </div>
    <ul>
      {puntos.map((p: string) => <li>{p}</li>)}
    </ul>
  </div>
</section>
