---
import { getCollection } from 'astro:content';
import clinica from '../data/clinica.json';
import { detectarIdioma, rutaEn, IDIOMAS } from '../utils/idioma';

const tel = 'tel:' + clinica.telefono.replace(/\s/g, '');
const wa = clinica.software_citas;

const pathname = Astro.url.pathname;
const idioma = detectarIdioma(pathname);
const prefijo = idioma === 'es' ? '' : '/' + idioma;

const especialidades = (await getCollection('especialidades', (e) => e.data.idioma === idioma))
  .sort((a, b) => a.data.orden - b.data.orden);
const tratamientos = await getCollection('tratamientos', (t) => t.data.idioma === idioma);

const hrefEspecialidad = (e: (typeof especialidades)[number]) =>
  `${prefijo}/especialidades/${e.id.replace(new RegExp(`^${idioma}/`), '')}/`;
const hrefTratamiento = (t: (typeof tratamientos)[number]) =>
  `${prefijo}/tratamientos/${t.id.replace(new RegExp(`^${idioma}/`), '')}/`;

const etiquetasIdioma = { es: 'español', ca: 'català', en: 'English' };
const verEnLabel = { es: 'Ver en', ca: 'Veure en', en: 'See in' }[idioma];
const otrosIdiomas = IDIOMAS.filter((i) => i !== idioma).map((i) => ({
  href: rutaEn(pathname, i),
  etiqueta: `${verEnLabel} ${etiquetasIdioma[i]}`,
}));

const t = {
  ca: {
    blurb: "Clínica dental a l'Eixample de Barcelona. Salut bucodental, estètica i atenció a l'esportista.",
    cita: 'Demanar cita per WhatsApp',
    especialidades: 'Especialitats',
    totesEspecialidades: 'Totes les especialitats',
    tratamientos: 'Tractaments',
    totsTratamientos: 'Tots els tractaments',
    donde: 'On som',
    comoLlegar: 'Com arribar-hi',
    horarios: 'Horaris',
    llamar: 'Trucar',
    googleReview: '5,0 a Google',
    legalTitulo: 'Legal',
    avisoLegal: 'Avís legal',
    privacidad: 'Política de privacitat',
    cookies: 'Política de cookies',
    legal:
      "El contingut sobre salut d'aquesta web està redactat i revisat per l'equip clínic de Doria Clinic. No rebem finançament extern ni allotgem publicitat de tercers. La informació publicada complementa, però no substitueix, la relació entre el professional sanitari i el pacient.",
    siguenosTitulo: 'Segueix-nos',
    siguenosTexto: "El dia a dia de la clínica, casos i consells, a l'Instagram.",
    financiacionEtiqueta: 'Amb Tu Medicina Financiada · Centre Premium',
    financiacionTitulo: 'Finança el teu tractament sense interessos',
    financiacionTexto: 'Fins al 100% en 12 mesos',
    financiacionCta: 'Veure com finançar',
  },
  en: {
    blurb: 'Dental clinic in the Eixample, Barcelona. Comprehensive oral health, aesthetics and care for athletes.',
    cita: 'Book by WhatsApp',
    especialidades: 'Specialties',
    totesEspecialidades: 'All specialties',
    tratamientos: 'Treatments',
    totsTratamientos: 'All treatments',
    donde: 'Where we are',
    comoLlegar: 'Get directions',
    horarios: 'Opening hours',
    llamar: 'Call',
    googleReview: '5.0 on Google',
    legalTitulo: 'Legal',
    avisoLegal: 'Legal notice',
    privacidad: 'Privacy policy',
    cookies: 'Cookie policy',
    legal:
      'The health content on this website is written and reviewed by the Doria Clinic clinical team. We receive no external funding and host no third-party advertising. The information published complements, but does not replace, the relationship between healthcare professional and patient.',
    siguenosTitulo: 'Follow us',
    siguenosTexto: "The clinic's day to day, cases and tips, on Instagram.",
    financiacionEtiqueta: 'With Tu Medicina Financiada · Premium Centre',
    financiacionTitulo: 'Finance your treatment interest-free',
    financiacionTexto: 'Up to 100% over 12 months',
    financiacionCta: 'See how to finance',
  },
  es: {
    blurb: 'Clínica dental en el Eixample de Barcelona. Salud bucodental, estética y atención al deportista.',
    cita: 'Pedir cita por WhatsApp',
    especialidades: 'Especialidades',
    totesEspecialidades: 'Todas las especialidades',
    tratamientos: 'Tratamientos',
    totsTratamientos: 'Todos los tratamientos',
    donde: 'Dónde estamos',
    comoLlegar: 'Cómo llegar',
    horarios: 'Horarios',
    llamar: 'Llamar',
    googleReview: '5,0 en Google',
    legalTitulo: 'Legal',
    avisoLegal: 'Aviso legal',
    privacidad: 'Política de privacidad',
    cookies: 'Política de cookies',
    legal:
      'El contenido sobre salud de esta web está redactado y revisado por el equipo clínico de Doria Clinic. No recibimos financiación externa ni alojamos publicidad de terceros. La información publicada complementa, pero no sustituye, la relación entre el profesional sanitario y el paciente.',
    siguenosTitulo: 'Síguenos',
    siguenosTexto: 'El día a día de la clínica, casos y consejos, en Instagram.',
    financiacionEtiqueta: 'Con Tu Medicina Financiada · Centro Premium',
    financiacionTitulo: 'Financia tu tratamiento sin intereses',
    financiacionTexto: 'Hasta el 100% en 12 meses',
    financiacionCta: 'Ver cómo financiar',
  },
}[idioma];

const diasTraducidos: Record<string, Record<string, string>> = {
  ca: {
    'Lunes a viernes': 'Dilluns a divendres',
    'Miércoles por la mañana': 'Dimecres al matí',
    'Sábado y domingo': 'Dissabte i diumenge',
  },
  en: {
    'Lunes a viernes': 'Monday to Friday',
    'Miércoles por la mañana': 'Wednesday morning',
    'Sábado y domingo': 'Saturday and Sunday',
  },
};
const franjaTraducida: Record<string, Record<string, string>> = {
  ca: { '10:00 – 14:00 y 16:00 – 20:00': '10:00 – 14:00 i 16:00 – 20:00', Cerrado: 'Tancat' },
  en: { '10:00 – 14:00 y 16:00 – 20:00': '10:00 AM – 2:00 PM and 4:00 PM – 8:00 PM', Cerrado: 'Closed' },
};
const diasCa = diasTraducidos[idioma] ?? {};
const franjaCa = franjaTraducida[idioma] ?? {};

const direccionCompleta = `${clinica.direccion.calle}, ${clinica.direccion.codigo_postal} ${clinica.direccion.ciudad}`;
// Buscamos por el nombre exacto de la ficha de Google Business (no solo
// "Doria Clinic": es ambiguo y el mapa no devuelve ningún resultado). Así
// el mapa muestra el pin con el nombre y la tarjeta de la ficha real, en
// vez de un pin sin etiqueta. Si ese campo se vaciara, caemos a las
// coordenadas exactas (sin etiqueta) y, en último caso, a la dirección.
const { lat, lng } = clinica.coordenadas;
const mapaQuery =
  clinica.nombre_google_maps ||
  (lat != null && lng != null ? `${lat},${lng}(${clinica.nombre})` : direccionCompleta);
const mapaSrc = `https://www.google.com/maps?q=${encodeURIComponent(mapaQuery)}&output=embed`;

const redes = [
  clinica.redes.instagram && { nombre: 'Instagram', url: clinica.redes.instagram, icono: 'instagram' },
  clinica.redes.linkedin && { nombre: 'LinkedIn', url: clinica.redes.linkedin, icono: 'linkedin' },
].filter(Boolean) as { nombre: string; url: string; icono: string }[];
const instagramHandle = clinica.redes.instagram?.replace(/\/$/, '').split('/').pop();
const esPaginaFinanciacion = /^\/(ca\/|en\/)?financiacion\/?$/.test(pathname);
---
{clinica.redes.instagram && (
  <Fragment>
  {!esPaginaFinanciacion && (
    <section class="financiacion-banner">
      <div class="wrap">
        <a class="financiacion-tarjeta" href={`${prefijo}/financiacion/`}>
          <div class="financiacion-texto">
            <span class="financiacion-etiqueta">{t.financiacionEtiqueta}</span>
            <strong>{t.financiacionTitulo}</strong>
            <span class="financiacion-sub">{t.financiacionTexto}</span>
          </div>
          <div class="financiacion-accion">
            <img class="financiacion-logo-tmf" src="/img/logo-tmf-blanco.png" alt="Tu Medicina Financiada" loading="lazy" />
            <span class="financiacion-cta">{t.financiacionCta} <span aria-hidden="true">→</span></span>
          </div>
        </a>
      </div>
    </section>
  )}

  <section class="rrss">
    <div class="wrap">
      <a class="rrss-tarjeta" href={clinica.redes.instagram} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/></svg>
        <span class="rrss-texto">
          <strong>{t.siguenosTitulo} @{instagramHandle}</strong>
          <span>{t.siguenosTexto}</span>
        </span>
        <span class="rrss-flecha" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
  </Fragment>
)}

<section class="mapa">
  <iframe
    src={mapaSrc}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    title={{ es: 'Mapa de ubicación de Doria Clinic', ca: 'Mapa d’ubicació de Doria Clinic', en: 'Map of Doria Clinic’s location' }[idioma]}
  ></iframe>
</section>

<footer class="pie" id="contacto">
  <div class="wrap">
    <div class="cuerpo">
      <div class="marca-col">
        <a class="marca" href={prefijo || '/'}><img src="/logo-doria.svg" alt="Doria Clinic" width="111" height="35" /></a>
        <p style="color:var(--verde-claro);max-width:34ch">{t.blurb}</p>
        {redes.length > 0 && (
          <div class="redes">
            {redes.map((r) => (
              <a href={r.url} aria-label={r.nombre} target="_blank" rel="noopener">
                {r.icono === 'instagram' ? (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/></svg>
                ) : (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3.5 9.5h3v11h-3zM9.5 9.5h2.9v1.5h.04c.4-.75 1.4-1.55 2.9-1.55 3.1 0 3.66 2 3.66 4.6v6.45h-3v-5.7c0-1.36-.02-3.1-1.9-3.1-1.9 0-2.2 1.5-2.2 3v5.8h-3v-11z"/></svg>
                )}
              </a>
            ))}
          </div>
        )}
        <a class="boton boton-verde" style="margin-top:1.4rem" href={wa} target="_blank" rel="noopener noreferrer">{t.cita}</a>
        <a class="resena-google" href={clinica.google_business_profile} target="_blank" rel="noopener">
          <span class="estrellas" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => (
              <svg viewBox="0 0 24 24"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279L12 19.771l-7.416 3.642 1.48-8.279L0 9.306l8.332-1.151z"/></svg>
            ))}
          </span>
          {t.googleReview}
        </a>
      </div>

      <div>
        <h3>{t.especialidades}</h3>
        <ul>
          {especialidades.map((e) => (
            <li><a href={hrefEspecialidad(e)}>{e.data.titulo}</a></li>
          ))}
          <li style="margin-top:.8rem"><a href={`${prefijo}/especialidades/`}>{t.totesEspecialidades} →</a></li>
        </ul>
      </div>

      <div>
        <h3>{t.tratamientos}</h3>
        <ul>
          {tratamientos.map((tr) => (
            <li><a href={hrefTratamiento(tr)}>{tr.data.titulo}</a></li>
          ))}
          <li style="margin-top:.8rem"><a href={`${prefijo}/tratamientos/`}>{t.totsTratamientos} →</a></li>
        </ul>
      </div>

      <div>
        <h3>{t.donde}</h3>
        <ul>
          <li>{clinica.direccion.calle}</li>
          <li>{clinica.direccion.codigo_postal} {clinica.direccion.ciudad}</li>
          <li style="margin-top:.8rem"><a href={clinica.google_business_profile}>{t.comoLlegar}</a></li>
          <li><a href={tel}>{clinica.telefono}</a></li>
          <li><a href={'mailto:' + clinica.email}>{clinica.email}</a></li>
        </ul>
      </div>

      <div>
        <h3>{t.horarios}</h3>
        <ul>
          {clinica.horarios.map((h) => (
            <li>{diasCa[h.dias] ?? h.dias}: {franjaCa[h.franja] ?? h.franja}</li>
          ))}
        </ul>
        <h3 style="margin-top:1.6rem">{t.legalTitulo}</h3>
        <ul>
          <li><a href={`${prefijo}/aviso-legal/`}>{t.avisoLegal}</a></li>
          <li><a href={`${prefijo}/politica-privacidad/`}>{t.privacidad}</a></li>
          <li><a href={`${prefijo}/politica-cookies/`}>{t.cookies}</a></li>
          {otrosIdiomas.map((o) => (
            <li class="idioma-pie"><a href={o.href}>{o.etiqueta}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="legal">
      <p>{t.legal}</p>
    </div>
  </div>
</footer>

<div class="flotante">
  <a href={tel}>{t.llamar}</a>
  <a href={wa} target="_blank" rel="noopener noreferrer">WhatsApp</a>
</div>
