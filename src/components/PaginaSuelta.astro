---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ReviewsModulo from './ReviewsModulo.astro';
import PorQueElegirnosModulo from './PorQueElegirnosModulo.astro';
import PrimeraVisitaModulo from './PrimeraVisitaModulo.astro';
import type { Idioma } from '../utils/idioma';

interface Props { entry: any; idioma: Idioma }
const { entry, idioma } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const etiquetaActualizado = {
  es: 'Última actualización',
  ca: 'Última actualització',
  en: 'Last updated',
}[idioma];
---
<Base
  titulo={d.seo.titulo_seo}
  descripcion={d.seo.meta_descripcion}
  noindex={d.seo.noindex}
  h1={d.titulo}
  lede={d.lede}
  anchoCompleto
>
  <Content />
  {d.actualizado && (
    <p><em>{etiquetaActualizado}: {d.actualizado}.</em></p>
  )}

  <Fragment slot="despues-contenido">
    <PrimeraVisitaModulo idioma={idioma} />
    <ReviewsModulo idioma={idioma} />
    <PorQueElegirnosModulo idioma={idioma} />
  </Fragment>
</Base>
