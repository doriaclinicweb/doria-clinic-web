---
import clinica from '../data/clinica.json';

interface Props { idioma: 'es' | 'ca' | 'en'; mensaje: string; parte?: 'acciones' | 'razones' }
const { idioma, mensaje, parte } = Astro.props;

const tel = 'tel:' + clinica.telefono.replace(/\s/g, '');
const wa = `https://wa.me/${clinica.whatsapp}?text=${encodeURIComponent(mensaje)}`;

const t = {
  ca: {
    cita: 'Demanar cita per WhatsApp',
    razones: [
      'Primera visita gratuïta, sense compromís',
      'Pressupost tancat per escrit',
      'Finançament a mida',
      'Servei d’urgències',
    ],
  },
  en: {
    cita: 'Book appointment by WhatsApp',
    razones: [
      'Free first visit, no obligation',
      'Fixed quote in writing',
      'Financing tailored to you',
      'Emergency service',
    ],
  },
  es: {
    cita: 'Pedir cita por WhatsApp',
    razones: [
      'Primera visita gratuita, sin compromiso',
      'Presupuesto cerrado por escrito',
      'Financiación a medida',
      'Servicio de urgencias',
    ],
  },
}[idioma];
---
{parte !== 'razones' && (
  <div class="acciones intro-acciones">
    <a class="boton boton-verde" href={wa} target="_blank" rel="noopener noreferrer">{t.cita}</a>
    <a class="boton boton-contorno" href={tel}>{clinica.telefono}</a>
  </div>
)}
{parte !== 'acciones' && (
  <ul class="razones">
    {t.razones.map((r) => (
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        <span>{r}</span>
      </li>
    ))}
  </ul>
)}
