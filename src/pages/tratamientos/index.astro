---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

const tratamientos = await getCollection(
  'tratamientos',
  (t) => t.data.idioma === 'es' && !t.data.seo.noindex
);
const conEspecialidad = await Promise.all(
  tratamientos.map(async (t) => ({ t, especialidad: await getEntry(t.data.especialidad) }))
);
---
<Base
  titulo="Tratamientos dentales en Barcelona | Doria Clinic"
  descripcion="Tratamientos concretos de Doria Clinic en el Eixample de Barcelona, con precio, duración y proceso detallado."
>
  <h1>Tratamientos</h1>
  <p class="lede">
    El detalle de precio, duración y proceso de cada tratamiento. Para conocer la
    especialidad completa, visita <a href="/especialidades/">especialidades</a>.
  </p>

  <div class="especialidades" style="margin:3rem 0 5rem">
    {conEspecialidad.map(({ t, especialidad }) => (
      <a href={`/tratamientos/${t.id.replace(/^es\//, '')}/`}>
        <h3>{t.data.titulo}</h3>
        <p>{t.data.resumen}</p>
        <span class="mas">{especialidad?.data.titulo} →</span>
      </a>
    ))}
  </div>
</Base>
