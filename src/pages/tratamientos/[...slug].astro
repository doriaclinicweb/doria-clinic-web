---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import clinica from '../../data/clinica.json';
import IntroAccion from '../../components/IntroAccion.astro';
import EquipoModulo from '../../components/EquipoModulo.astro';
import ReviewsModulo from '../../components/ReviewsModulo.astro';
import PrimeraVisitaModulo from '../../components/PrimeraVisitaModulo.astro';

export async function getStaticPaths() {
  const tratamientos = await getCollection(
    'tratamientos',
    (t) => t.data.idioma === 'es' && !t.data.seo.noindex
  );
  return tratamientos.map((t) => ({
    params: { slug: t.id.replace(/^es\//, '') },
    props: { tratamiento: t },
  }));
}

const { tratamiento } = Astro.props;
const d = tratamiento.data;
const { Content } = await render(tratamiento);
const especialidad = await getEntry(d.especialidad);
const doctor = await getEntry(d.especialista);

const relacionados = (
  await getCollection(
    'tratamientos',
    (t) => t.data.idioma === 'es' && t.data.especialidad.id === d.especialidad.id && t.id !== tratamiento.id
  )
);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalProcedure',
  name: d.titulo,
  description: d.resumen,
  provider: { '@type': 'Dentist', name: clinica.nombre, address: clinica.direccion.calle },
  ...(d.faqs.length && {
    subjectOf: {
      '@type': 'FAQPage',
      mainEntity: d.faqs.map((f) => ({
        '@type': 'Question',
        name: f.pregunta,
        acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
      })),
    },
  }),
};

const anestesias = { no: 'Sin anestesia', local: 'Anestesia local', sedacion: 'Sedación' };
const imagenCabecera = d.imagen || especialidad?.data.imagen;
---
<Base
  titulo={d.seo.titulo_seo}
  descripcion={d.seo.meta_descripcion}
  noindex={d.seo.noindex}
  schema={schema}
  h1={d.titulo}
  lede={d.resumen}
  migas={[
    { href: '/especialidades/', etiqueta: 'Especialidades' },
    { href: `/especialidades/${especialidad.id.replace(/^es\//, '')}/`, etiqueta: especialidad?.data.titulo },
  ]}
  imagenCabecera={imagenCabecera ? { src: imagenCabecera, alt: d.titulo } : undefined}
  introDosColumnas
  anchoDoble
>
  <Fragment slot="intro-acciones">
    <IntroAccion idioma="es" mensaje={'Hola, quería información sobre ' + d.titulo} parte="acciones" />
  </Fragment>
  <Fragment slot="intro-razones">
    <IntroAccion idioma="es" mensaje={'Hola, quería información sobre ' + d.titulo} parte="razones" />
  </Fragment>

  <div class="columnas">
    <div>
      <Content />

      <div class="indicaciones">
        <strong>Cuándo se indica {d.titulo}</strong>
        <ul>{d.cuando_se_indica.map((s) => <li set:html={s} />)}</ul>
      </div>

      {d.proceso?.length ? (
        <>
          <h2>Cómo es el proceso de {d.titulo}</h2>
          <ol class="proceso">
            {d.proceso.map((p) => (
              <li>
                <strong>{p.titulo}</strong>
                <div set:html={p.descripcion} />
              </li>
            ))}
          </ol>
        </>
      ) : null}

      {d.faqs.length ? (
        <>
          <h2>Preguntas frecuentes sobre {d.titulo}</h2>
          {d.faqs.map((f) => (
            <details class="faq">
              <summary>{f.pregunta}</summary>
              <p set:html={f.respuesta} />
            </details>
          ))}
        </>
      ) : null}

      {relacionados.length > 0 && (
        <>
          <h2>Tratamientos relacionados con {d.titulo}</h2>
          <div class="especialidades">
            {relacionados.map((t) => (
              <a href={`/tratamientos/${t.id.replace(/^es\//, '')}/`}>
                <h3>{t.data.titulo}</h3>
                <p>{t.data.resumen}</p>
                <span class="mas">Ver tratamiento →</span>
              </a>
            ))}
          </div>
        </>
      )}
    </div>

    <div class="ficha-envoltorio">

      <aside class="ficha">
      {doctor && doctor.data.foto && (
        <img class="foto" src={doctor.data.foto} alt={doctor.data.nombre} loading="lazy" />
      )}
      <div class="ficha-info">
        <dl>
          {d.precio_desde ? (<><dt>Desde</dt><dd>{d.precio_desde} €</dd></>) : null}
          {d.financiacion_meses ? (<><dt><a href="/financiacion/">Financiación</a></dt><dd>{d.financiacion_meses} meses</dd></>) : null}
          {d.duracion_sesion ? (<><dt>Sesión</dt><dd>{d.duracion_sesion}</dd></>) : null}
          {d.numero_sesiones ? (<><dt>Sesiones</dt><dd>{d.numero_sesiones}</dd></>) : null}
          {d.anestesia ? (<><dt>Anestesia</dt><dd>{anestesias[d.anestesia]}</dd></>) : null}
        </dl>

        <div class="firma">
          <strong><a href={`/equipo/${doctor?.id}/`}>{doctor?.data.nombre}</a></strong>
          {doctor?.data.cargo}
          <span class="colegiado">Col. {doctor?.data.numero_colegiado}</span>
        </div>

        <a class="boton boton-verde cta" href={`https://wa.me/${clinica.whatsapp}?text=${encodeURIComponent('Hola, quería información sobre ' + d.titulo)}`} target="_blank" rel="noopener noreferrer">
          Preguntar por WhatsApp
        </a>
      </div>
    </aside>
    </div>
  </div>

  <Fragment slot="despues-contenido">
    <PrimeraVisitaModulo idioma="es" />
    <ReviewsModulo idioma="es" />
    <EquipoModulo idioma="es" titulo="Nuestro equipo" />
  </Fragment>
</Base>
