---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import clinica from '../data/clinica.json';

const destacadas = (await getCollection('especialidades', (e) => e.data.idioma === 'es' && e.data.destacada))
  .sort((a, b) => a.data.orden - b.data.orden);
---
<Base titulo="Clínica dental en el Eixample de Barcelona | Doria Clinic" descripcion="Clínica dental en Carrer Villarroel, Barcelona, especializada en salud bucodental integral, estética dental y atención al deportista.">
  <h1>Cuidamos personas, no solo sonrisas</h1>
  <p class="lede">
    Clínica dental en el Eixample especializada en salud bucodental integral, estética
    dental y atención al deportista. Sin prisas y sin sorpresas.
  </p>

  <div class="rejilla">
    {destacadas.map((e) => (
      <a href={`/tratamientos/${e.id.replace(/^es\//, '')}/`}>
        <h3>{e.data.titulo}</h3>
        <p>{e.data.resumen}</p>
      </a>
    ))}
  </div>

  <h2>Primera visita</h2>
  <p>
    Revisión completa, diagnóstico personalizado y un plan de tratamiento adaptado a ti.
    Nos tomamos el tiempo de escucharte y resolver tus dudas, sin compromiso.
  </p>
  <a class="cta" href={clinica.software_citas}>Pedir cita por WhatsApp</a>
</Base>
