---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import IntroAccion from '../../../components/IntroAccion.astro';

const especialidades = (await getCollection('especialidades', (e) => e.data.idioma === 'en'))
  .sort((a, b) => a.data.orden - b.data.orden);
const url = (e) => '/en/especialidades/' + e.id.replace(/^en\//, '') + '/';

const faqs = [
  {
    pregunta: 'What dental specialties does Doria Clinic offer?',
    respuesta:
      'We cover every area of oral health: general dentistry, orthodontics, endodontics, periodontics, dental implants, dental aesthetics, paediatric dentistry, oral surgery, dental prosthetics, dental traumatology and sports dentistry. Each specialty is led by the team doctor specifically trained in it.',
  },
  {
    pregunta: 'Do I need to see a general dentist first?',
    respuesta:
      'Not necessarily. At your first visit we assess your case and, if you need a specific specialist, we refer you directly within the same team, without wasting time or having to repeat explanations at another clinic.',
  },
  {
    pregunta: 'Can I be treated for several specialties at the same clinic?',
    respuesta:
      'Yes. The whole team works in the same space in the Eixample, so you can coordinate, for example, orthodontics and dental aesthetics, or implants and periodontics, without changing clinics or repeating tests.',
  },
  {
    pregunta: 'Is the first visit with a specialist free?',
    respuesta:
      'Yes. The first visit includes a full check-up and a written treatment plan, with no obligation to continue.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
  })),
};
---
<Base
  titulo="Dental Specialties in Barcelona | Doria Clinic"
  descripcion="Doria Clinic's dental specialties in the Eixample, Barcelona: implants, endodontics, orthodontics, periodontics, dental aesthetics, paediatric dentistry and sports dentistry."
  h1="Specialties"
  lede="Each area is led by the doctor trained in it. That's how we approach oral health as a whole, with a free, no-obligation first visit."
  schema={schema}
>
  <Fragment slot="intro-extra">
    <IntroAccion idioma="en" mensaje="Hi, I'd like to book an appointment" />
  </Fragment>

  <div class="especialidades">
    {especialidades.map((e) => (
      <a href={url(e)}>
        <h3>{e.data.titulo}</h3>
        <p>{e.data.resumen}</p>
        <span class="mas">View specialty →</span>
      </a>
    ))}
  </div>

  <h2>Frequently asked questions about our specialties</h2>
  {faqs.map((f) => (
    <details class="faq">
      <summary>{f.pregunta}</summary>
      <p>{f.respuesta}</p>
    </details>
  ))}
</Base>
