---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import clinica from '../../../data/clinica.json';
import IntroAccion from '../../../components/IntroAccion.astro';
import EquipoModulo from '../../../components/EquipoModulo.astro';

export async function getStaticPaths() {
  const especialidades = await getCollection(
    'especialidades',
    (e) => e.data.idioma === 'en' && !e.data.seo.noindex
  );
  return especialidades.map((e) => ({
    params: { slug: e.id.replace(/^en\//, '') },
    props: { especialidad: e },
  }));
}

const { especialidad } = Astro.props;
const d = especialidad.data;
const { Content } = await render(especialidad);
const doctor = d.especialista ? await getEntry(d.especialista) : null;
const cargoEn = doctor ? doctor.data.cargo_en || doctor.data.cargo : null;

const tratamientos = await getCollection(
  'tratamientos',
  (t) => t.data.especialidad.id === especialidad.id
);

const wa = (texto: string) =>
  `https://wa.me/${clinica.whatsapp}?text=${encodeURIComponent(texto)}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalSpecialty',
  name: d.titulo,
  description: d.resumen,
  ...(d.faqs.length && {
    subjectOf: {
      '@type': 'FAQPage',
      mainEntity: d.faqs.map((f) => ({
        '@type': 'Question',
        name: f.pregunta,
        acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
      })),
    },
  }),
};
---
<Base
  titulo={d.seo.titulo_seo}
  descripcion={d.seo.meta_descripcion}
  noindex={d.seo.noindex}
  schema={schema}
  h1={d.titulo}
  lede={d.subtitulo}
  migas={[{ href: '/en/especialidades/', etiqueta: 'Specialties' }]}
  imagenCabecera={d.imagen ? { src: d.imagen, alt: d.titulo } : undefined}
  introDosColumnas
  anchoDoble
>
  <Fragment slot="intro-acciones">
    <IntroAccion idioma="en" mensaje={'Hi, I would like information about ' + d.titulo} parte="acciones" />
  </Fragment>
  <Fragment slot="intro-razones">
    <IntroAccion idioma="en" mensaje={'Hi, I would like information about ' + d.titulo} parte="razones" />
  </Fragment>

  <div class="columnas">
    <div>
      <Content />

      {d.faqs.length ? (
        <>
          <h2>Frequently asked questions about {d.titulo}</h2>
          {d.faqs.map((f) => (
            <details class="faq">
              <summary>{f.pregunta}</summary>
              <p set:html={f.respuesta} />
            </details>
          ))}
        </>
      ) : null}

      {tratamientos.length > 0 && (
        <>
          <h2>Treatments related to {d.titulo}</h2>
          <div class="especialidades">
            {tratamientos.map((t) => (
              <a href={`/en/tratamientos/${t.id.replace(/^en\//, '')}/`}>
                <h3>{t.data.titulo}</h3>
                <p>{t.data.resumen}</p>
                <span class="mas">View treatment →</span>
              </a>
            ))}
          </div>
        </>
      )}
    </div>

    <div class="ficha-envoltorio">

      <aside class="ficha">
      {doctor && doctor.data.foto && (
        <img class="foto" src={doctor.data.foto} alt={doctor.data.nombre} loading="lazy" />
      )}
      <div class="ficha-info">
        {doctor && (
          <div class="firma">
            <strong><a href={`/en/equipo/${doctor.id}/`}>{doctor.data.nombre}</a></strong>
            {cargoEn}
            <span class="colegiado">Reg. no. {doctor.data.numero_colegiado}</span>
          </div>
        )}
        <a class="boton boton-verde cta" href={wa('Hi, I would like information about ' + d.titulo)} target="_blank" rel="noopener noreferrer">
          Ask on WhatsApp
        </a>
      </div>
    </aside>
    </div>
  </div>

  <Fragment slot="despues-contenido">
    <EquipoModulo idioma="en" titulo="Our team" />
  </Fragment>
</Base>
