---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import clinica from '../../../data/clinica.json';
import IntroAccion from '../../../components/IntroAccion.astro';
import EquipoModulo from '../../../components/EquipoModulo.astro';

export async function getStaticPaths() {
  const tratamientos = await getCollection(
    'tratamientos',
    (t) => t.data.idioma === 'en' && !t.data.seo.noindex
  );
  return tratamientos.map((t) => ({
    params: { slug: t.id.replace(/^en\//, '') },
    props: { tratamiento: t },
  }));
}

const { tratamiento } = Astro.props;
const d = tratamiento.data;
const { Content } = await render(tratamiento);
const especialidad = await getEntry(d.especialidad);
const doctor = await getEntry(d.especialista);
const cargoEn = doctor.data.cargo_en || doctor.data.cargo;

const relacionados = (
  await getCollection(
    'tratamientos',
    (t) => t.data.idioma === 'en' && t.data.especialidad.id === d.especialidad.id && t.id !== tratamiento.id
  )
);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalProcedure',
  name: d.titulo,
  description: d.resumen,
  provider: { '@type': 'Dentist', name: clinica.nombre, address: clinica.direccion.calle },
  ...(d.faqs.length && {
    subjectOf: {
      '@type': 'FAQPage',
      mainEntity: d.faqs.map((f) => ({
        '@type': 'Question',
        name: f.pregunta,
        acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
      })),
    },
  }),
};

const anestesias = { no: 'No anaesthesia', local: 'Local anaesthesia', sedacion: 'Sedation' };
const imagenCabecera = d.imagen || especialidad?.data.imagen;
---
<Base
  titulo={d.seo.titulo_seo}
  descripcion={d.seo.meta_descripcion}
  noindex={d.seo.noindex}
  schema={schema}
  h1={d.titulo}
  lede={d.resumen}
  migas={[
    { href: '/en/especialidades/', etiqueta: 'Specialties' },
    { href: `/en/especialidades/${especialidad.id.replace(/^en\//, '')}/`, etiqueta: especialidad?.data.titulo },
  ]}
  imagenCabecera={imagenCabecera ? { src: imagenCabecera, alt: d.titulo } : undefined}
  introDosColumnas
  anchoDoble
>
  <Fragment slot="intro-acciones">
    <IntroAccion idioma="en" mensaje={'Hi, I would like information about ' + d.titulo} parte="acciones" />
  </Fragment>
  <Fragment slot="intro-razones">
    <IntroAccion idioma="en" mensaje={'Hi, I would like information about ' + d.titulo} parte="razones" />
  </Fragment>

  <div class="columnas">
    <div>
      <Content />

      <div class="indicaciones">
        <strong>When {d.titulo} is indicated</strong>
        <ul>{d.cuando_se_indica.map((s) => <li set:html={s} />)}</ul>
      </div>

      {d.proceso?.length ? (
        <>
          <h2>What the process of {d.titulo} looks like</h2>
          <ol class="proceso">
            {d.proceso.map((p) => (
              <li>
                <strong>{p.titulo}</strong>
                <div set:html={p.descripcion} />
              </li>
            ))}
          </ol>
        </>
      ) : null}

      {d.faqs.length ? (
        <>
          <h2>Frequently asked questions about {d.titulo}</h2>
          {d.faqs.map((f) => (
            <details class="faq">
              <summary>{f.pregunta}</summary>
              <p set:html={f.respuesta} />
            </details>
          ))}
        </>
      ) : null}

      {relacionados.length > 0 && (
        <>
          <h2>Treatments related to {d.titulo}</h2>
          <div class="especialidades">
            {relacionados.map((t) => (
              <a href={`/en/tratamientos/${t.id.replace(/^en\//, '')}/`}>
                <h3>{t.data.titulo}</h3>
                <p>{t.data.resumen}</p>
                <span class="mas">View treatment →</span>
              </a>
            ))}
          </div>
        </>
      )}
    </div>

    <div class="ficha-envoltorio">

      <aside class="ficha">
      {doctor && doctor.data.foto && (
        <img class="foto" src={doctor.data.foto} alt={doctor.data.nombre} loading="lazy" />
      )}
      <div class="ficha-info">
        <dl>
          {d.precio_desde ? (<><dt>From</dt><dd>€{d.precio_desde}</dd></>) : null}
          {d.financiacion_meses ? (<><dt><a href="/en/financiacion/">Financing</a></dt><dd>{d.financiacion_meses} months</dd></>) : null}
          {d.duracion_sesion ? (<><dt>Session</dt><dd>{d.duracion_sesion}</dd></>) : null}
          {d.numero_sesiones ? (<><dt>Sessions</dt><dd>{d.numero_sesiones}</dd></>) : null}
          {d.anestesia ? (<><dt>Anaesthesia</dt><dd>{anestesias[d.anestesia]}</dd></>) : null}
        </dl>

        <div class="firma">
          <strong><a href={`/en/equipo/${doctor?.id}/`}>{doctor?.data.nombre}</a></strong>
          {cargoEn}
          <span class="colegiado">Reg. no. {doctor?.data.numero_colegiado}</span>
        </div>

        <a class="boton boton-verde cta" href={`https://wa.me/${clinica.whatsapp}?text=${encodeURIComponent('Hi, I would like information about ' + d.titulo)}`} target="_blank" rel="noopener noreferrer">
          Ask on WhatsApp
        </a>
      </div>
    </aside>
    </div>
  </div>

  <Fragment slot="despues-contenido">
    <EquipoModulo idioma="en" titulo="Our team" />
  </Fragment>
</Base>
