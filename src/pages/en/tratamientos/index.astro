---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import IntroAccion from '../../../components/IntroAccion.astro';

const tratamientos = await getCollection(
  'tratamientos',
  (t) => t.data.idioma === 'en' && !t.data.seo.noindex
);
const conEspecialidad = await Promise.all(
  tratamientos.map(async (t) => ({ t, especialidad: await getEntry(t.data.especialidad) }))
);

const faqs = [
  {
    pregunta: 'Are treatment prices fixed?',
    respuesta:
      'Yes. At your first visit we give you a written quote with a fixed price before starting, with no surprises or extra charges partway through treatment.',
  },
  {
    pregunta: 'Do you offer financing?',
    respuesta:
      'Yes, we tailor financing to each case so you can spread the cost of treatment over comfortable monthly instalments.',
  },
  {
    pregunta: 'How many sessions will I need to complete a treatment?',
    respuesta:
      'It depends on the treatment and your specific case. On each treatment page we give an indicative number of sessions, and we confirm it precisely at your first visit.',
  },
  {
    pregunta: 'Can I start a treatment without committing to finish it?',
    respuesta:
      'Yes. We explain every stage and its cost before starting, and you decide, with no obligation, whether to continue at each step.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
  })),
};
---
<Base
  titulo="Dental Treatments in Barcelona | Doria Clinic"
  descripcion="Doria Clinic's specific treatments in the Eixample, Barcelona, with price, duration and detailed process."
  h1="Treatments"
  lede="The detail of price, duration and process for each treatment, with a fixed quote in writing and no obligation."
  schema={schema}
>
  <Fragment slot="intro-extra">
    <IntroAccion idioma="en" mensaje="Hi, I'd like information about a treatment" />
  </Fragment>

  <p style="margin-top:-1.5rem">
    To see the full specialty, visit <a href="/en/especialidades/">specialties</a>.
  </p>

  <div class="especialidades">
    {conEspecialidad.map(({ t, especialidad }) => (
      <a href={`/en/tratamientos/${t.id.replace(/^en\//, '')}/`}>
        <h3>{t.data.titulo}</h3>
        <p>{t.data.resumen}</p>
        <span class="mas">{especialidad?.data.titulo} →</span>
      </a>
    ))}
  </div>

  <h2>Frequently asked questions about our treatments</h2>
  {faqs.map((f) => (
    <details class="faq">
      <summary>{f.pregunta}</summary>
      <p>{f.respuesta}</p>
    </details>
  ))}
</Base>
