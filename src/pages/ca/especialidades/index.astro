---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import IntroAccion from '../../../components/IntroAccion.astro';

const especialidades = (await getCollection('especialidades', (e) => e.data.idioma === 'ca'))
  .sort((a, b) => a.data.orden - b.data.orden);
const url = (e) => '/ca/especialidades/' + e.id.replace(/^ca\//, '') + '/';

const faqs = [
  {
    pregunta: 'Quines especialitats dentals té Doria Clinic?',
    respuesta:
      'Cobrim totes les àrees de la salut bucodental: odontologia general, ortodòncia, endodòncia, periodòncia, implants dentals, estètica dental, odontopediatria, cirurgia oral, pròtesi dental, traumatologia dental i odontologia esportiva. Cada especialitat la porta el doctor de l’equip format específicament en ella.',
  },
  {
    pregunta: 'He de passar primer pel dentista general?',
    respuesta:
      'No és imprescindible. A la primera visita valorem el teu cas i, si necessites un especialista concret, et derivem directament dins del mateix equip, sense perdre temps ni haver de repetir explicacions en una altra clínica.',
  },
  {
    pregunta: 'Puc tractar diverses especialitats a la mateixa clínica?',
    respuesta:
      'Sí. Tot l’equip treballa al mateix espai de l’Eixample, així que pots coordinar, per exemple, ortodòncia i estètica dental, o implants i periodòncia, sense canviar de clínica ni repetir proves.',
  },
  {
    pregunta: 'La primera visita amb l’especialista és gratuïta?',
    respuesta:
      'Sí. La primera visita inclou una revisió completa i un pla de tractament per escrit, sense compromís de continuar.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
  })),
};
---
<Base
  titulo="Especialitats dentals a Barcelona | Doria Clinic"
  descripcion="Especialitats de Doria Clinic a l'Eixample de Barcelona: implants, endodòncia, ortodòncia, periodòncia, estètica dental, odontopediatria i odontologia esportiva."
  h1="Especialitats"
  lede="Cada àrea la porta el doctor format en ella. Així treballem la salut bucodental de manera integral, amb primera visita gratuïta i sense compromís."
  schema={schema}
>
  <Fragment slot="intro-extra">
    <IntroAccion idioma="ca" mensaje="Hola, vull demanar cita" />
  </Fragment>

  <div class="especialidades">
    {especialidades.map((e) => (
      <a href={url(e)}>
        <h3>{e.data.titulo}</h3>
        <p>{e.data.resumen}</p>
        <span class="mas">Veure especialitat →</span>
      </a>
    ))}
  </div>

  <h2>Preguntes freqüents sobre les nostres especialitats</h2>
  {faqs.map((f) => (
    <details class="faq">
      <summary>{f.pregunta}</summary>
      <p>{f.respuesta}</p>
    </details>
  ))}
</Base>
