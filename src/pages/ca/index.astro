---
import { getCollection } from 'astro:content';
import '../../styles/global.css';
import clinica from '../../data/clinica.json';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { fotosEquipo } from '../../data/equipo-fotos';
import { equipoCa } from '../../data/equipo-ca';

const IMG = 'https://doria.clinic/wp-content/uploads';

const especialidades = (await getCollection('especialidades', (e) => e.data.idioma === 'ca'))
  .sort((a, b) => a.data.orden - b.data.orden);
const deportiva = especialidades.find((e) => e.id.endsWith('odontologia-deportiva'));
const resto = especialidades.filter((e) => e !== deportiva).slice(0, 7);

const equipo = (await getCollection('equipo')).sort((a, b) => a.data.orden - b.data.orden);
const fotos = fotosEquipo;

const url = (e) => '/ca/especialidades/' + e.id.replace(/^ca\//, '') + '/';
const wa = clinica.software_citas;
const tel = 'tel:' + clinica.telefono.replace(/\s/g, '');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: clinica.nombre,
  telephone: clinica.telefono,
  email: clinica.email,
  url: 'https://doria.clinic',
  address: {
    '@type': 'PostalAddress',
    streetAddress: clinica.direccion.calle,
    postalCode: clinica.direccion.codigo_postal,
    addressLocality: clinica.direccion.ciudad,
    addressCountry: 'ES',
  },
  openingHours: 'Mo-Fr 10:00-14:00, Mo-Fr 16:00-20:00',
  medicalSpecialty: 'Dentistry',
};
---
<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Clínica dental a l'Eixample de Barcelona | Doria Clinic</title>
    <meta name="description" content="Clínica dental a Carrer Villarroel, Barcelona. Salut bucodental integral, estètica dental i atenció a l'esportista. Primera visita sense compromís." />
    <link rel="canonical" href="https://doria.clinic/ca/" />
    <link rel="alternate" hreflang="es" href="https://doria.clinic/" />
    <link rel="alternate" hreflang="ca" href="https://doria.clinic/ca/" />
    <link rel="alternate" hreflang="x-default" href="https://doria.clinic/" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ca_ES" />
    <meta property="og:site_name" content={clinica.nombre} />
    <meta property="og:url" content="https://doria.clinic/ca/" />
    <meta property="og:title" content="Clínica dental a l'Eixample de Barcelona | Doria Clinic" />
    <meta property="og:description" content="Clínica dental a Carrer Villarroel, Barcelona. Salut bucodental integral, estètica dental i atenció a l'esportista. Primera visita sense compromís." />
    <meta property="og:image" content={IMG + '/2025/12/1-10.jpg'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Clínica dental a l'Eixample de Barcelona | Doria Clinic" />
    <meta name="twitter:description" content="Clínica dental a Carrer Villarroel, Barcelona. Salut bucodental integral, estètica dental i atenció a l'esportista. Primera visita sense compromís." />
    <meta name="twitter:image" content={IMG + '/2025/12/1-10.jpg'} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <Header variante="hero" />

    <section class="hero">
      <img src={IMG + '/2025/12/1-10.jpg'} alt="Recepció de Doria Clinic, amb taulell de fusta i llum natural" fetchpriority="high" />
      <div class="wrap">
        <h1>La nostra especialitat és el teu benestar</h1>
        <p class="entradilla">
          Clínica dental a l'Eixample especialitzada en salut bucodental, estètica
          i atenció a l'esportista.
        </p>
        <div class="acciones">
          <a class="boton boton-primario" href={wa}>Demanar cita per WhatsApp</a>
          <a class="boton boton-fantasma" href={tel}>{clinica.telefono}</a>
        </div>
      </div>
    </section>

    <section class="seccion intro">
      <div class="wrap cuerpo">
        <p>Cuidem persones, no només somriures.</p>
        <div>
          <p>
            Som un equip d'odontòlegs amb una manera pròpia de fer les coses: amb
            rigor, proximitat i atenció a cada detall. Creiem que anar al dentista no
            hauria de generar dubtes ni incomoditat.
          </p>
          <p>
            Per això t'oferim una experiència pensada perquè et sentis còmode,
            tranquil i ben acompanyat des del primer dia.
          </p>
        </div>
      </div>
    </section>

    <section class="seccion" id="tratamientos">
      <div class="wrap">
        <h2>Tractaments</h2>
        <div class="especialidades">
          {deportiva && (
            <a class="ancha" href={url(deportiva)}>
              <h3>{deportiva.data.titulo}</h3>
              <p>{deportiva.data.resumen}</p>
              <span class="mas">Protectors bucals a mida i salut oral de l'esportista →</span>
            </a>
          )}
          {resto.map((e) => (
            <a href={url(e)}>
              <h3>{e.data.titulo}</h3>
              <p>{e.data.resumen}</p>
              <span class="mas">Veure tractament →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="seccion" id="equipo">
      <div class="wrap">
        <h2>Més que dentistes: el teu equip de confiança</h2>
        <div class="equipo">
          {equipo.map((d) => (
            <figure>
              <img src={fotos[d.id]} alt={d.data.nombre} loading="lazy" />
              <figcaption>
                <span class="nombre">{d.data.nombre}</span>
                <span class="puesto">{equipoCa[d.id]?.cargo ?? d.data.cargo}</span>
                <ul>{(equipoCa[d.id]?.titulacion ?? d.data.titulacion).slice(0, 3).map((t) => <li>{t}</li>)}</ul>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="seccion visita">
      <div class="wrap cuerpo">
        <div>
          <h2>La teva primera visita</h2>
          <p>
            Revisió completa, diagnòstic personalitzat i un pla de tractament adaptat
            a tu. Ens prenem el temps d'escoltar-te i de resoldre tots els teus dubtes.
          </p>
          <div class="acciones" style="margin-top:2rem">
            <a class="boton boton-primario" href={wa}>Reservar per WhatsApp</a>
          </div>
        </div>
        <ul>
          <li>Sense compromís i sense presses</li>
          <li>Pressupost tancat per escrit</li>
          <li>Finançament a mida</li>
          <li>Urgències al {clinica.telefono_urgencias}</li>
        </ul>
      </div>
    </section>

    <section class="seccion" id="espacio">
      <div class="wrap">
        <h2>Instal·lacions</h2>
        <p style="margin-bottom:2.5rem">
          Cada racó està pensat perquè et sentis còmode: llum natural, materials
          càlids i un ambient que transmet calma.
        </p>
        <div class="espacio">
          <figure><img src={IMG + '/2025/12/3-10.jpg'} alt="Odontopediatra explicant el tractament a un nen" loading="lazy" /></figure>
          <figure><img src={IMG + '/2025/12/4-9.jpg'} alt="Interior de la clínica" loading="lazy" /></figure>
          <figure><img src={IMG + '/2025/12/1-10.jpg'} alt="Zona d'espera" loading="lazy" /></figure>
        </div>
      </div>
    </section>

    <section class="seccion" style="background:var(--gris)">
      <div class="wrap">
        <h2>Què diuen els nostres pacients</h2>
        <div class="opiniones">
          <blockquote>
            <q>El trato es cercano, profesional y muy humano. Se nota que sabe lo que hace, siempre salgo encantada con el resultado.</q>
            <cite>Yvonne Bayer</cite>
          </blockquote>
          <blockquote>
            <q>Equipo honesto y muy profesional. Recomiendo esta clínica tanto para adultos como para niños.</q>
            <cite>Hugo M. R.</cite>
          </blockquote>
          <blockquote>
            <q>Un trato de 10, ir al dentista así da gusto. Volveremos seguro.</q>
            <cite>Marta Bestard</cite>
          </blockquote>
        </div>
      </div>
    </section>

    <Footer />
  </body>
</html>
