---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import clinica from '../../../data/clinica.json';
import IntroAccion from '../../../components/IntroAccion.astro';
import EquipoModulo from '../../../components/EquipoModulo.astro';

export async function getStaticPaths() {
  const tratamientos = await getCollection(
    'tratamientos',
    (t) => t.data.idioma === 'ca' && !t.data.seo.noindex
  );
  return tratamientos.map((t) => ({
    params: { slug: t.id.replace(/^ca\//, '') },
    props: { tratamiento: t },
  }));
}

const { tratamiento } = Astro.props;
const d = tratamiento.data;
const { Content } = await render(tratamiento);
const especialidad = await getEntry(d.especialidad);
const doctor = await getEntry(d.especialista);
const cargoCa = doctor.data.cargo_ca || doctor.data.cargo;

const relacionados = (
  await getCollection(
    'tratamientos',
    (t) => t.data.idioma === 'ca' && t.data.especialidad.id === d.especialidad.id && t.id !== tratamiento.id
  )
);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalProcedure',
  name: d.titulo,
  description: d.resumen,
  provider: { '@type': 'Dentist', name: clinica.nombre, address: clinica.direccion.calle },
  ...(d.faqs.length && {
    subjectOf: {
      '@type': 'FAQPage',
      mainEntity: d.faqs.map((f) => ({
        '@type': 'Question',
        name: f.pregunta,
        acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
      })),
    },
  }),
};

const anestesias = { no: 'Sense anestèsia', local: 'Anestèsia local', sedacion: 'Sedació' };
const imagenCabecera = d.imagen || especialidad?.data.imagen;
---
<Base
  titulo={d.seo.titulo_seo}
  descripcion={d.seo.meta_descripcion}
  noindex={d.seo.noindex}
  schema={schema}
  h1={d.titulo}
  lede={d.resumen}
  migas={[
    { href: '/ca/especialidades/', etiqueta: 'Especialitats' },
    { href: `/ca/especialidades/${especialidad.id.replace(/^ca\//, '')}/`, etiqueta: especialidad?.data.titulo },
  ]}
  imagenCabecera={imagenCabecera ? { src: imagenCabecera, alt: d.titulo } : undefined}
  introDosColumnas
  anchoDoble
>
  <Fragment slot="intro-acciones">
    <IntroAccion idioma="ca" mensaje={'Hola, voldria informació sobre ' + d.titulo} parte="acciones" />
  </Fragment>
  <Fragment slot="intro-razones">
    <IntroAccion idioma="ca" mensaje={'Hola, voldria informació sobre ' + d.titulo} parte="razones" />
  </Fragment>

  <div class="columnas">
    <div>
      <Content />

      <div class="indicaciones">
        <strong>Quan s'indica {d.titulo}</strong>
        <ul>{d.cuando_se_indica.map((s) => <li>{s}</li>)}</ul>
      </div>

      {d.proceso?.length ? (
        <>
          <h2>Com és el procés de {d.titulo}</h2>
          <ol class="proceso">
            {d.proceso.map((p) => (
              <li>
                <strong>{p.titulo}</strong>
                <div>{p.descripcion}</div>
              </li>
            ))}
          </ol>
        </>
      ) : null}

      {d.faqs.length ? (
        <>
          <h2>Preguntes freqüents sobre {d.titulo}</h2>
          {d.faqs.map((f) => (
            <details class="faq">
              <summary>{f.pregunta}</summary>
              <p>{f.respuesta}</p>
            </details>
          ))}
        </>
      ) : null}

      {relacionados.length > 0 && (
        <>
          <h2>Tractaments relacionats amb {d.titulo}</h2>
          <div class="especialidades">
            {relacionados.map((t) => (
              <a href={`/ca/tratamientos/${t.id.replace(/^ca\//, '')}/`}>
                <h3>{t.data.titulo}</h3>
                <p>{t.data.resumen}</p>
                <span class="mas">Veure tractament →</span>
              </a>
            ))}
          </div>
        </>
      )}
    </div>

    <div class="ficha-envoltorio">

      <aside class="ficha">
      {doctor && doctor.data.foto && (
        <img class="foto" src={doctor.data.foto} alt={doctor.data.nombre} loading="lazy" />
      )}
      <div class="ficha-info">
        <dl>
          {d.precio_desde ? (<><dt>Des de</dt><dd>{d.precio_desde} €</dd></>) : null}
          {d.financiacion_meses ? (<><dt>Finançament</dt><dd>{d.financiacion_meses} mesos</dd></>) : null}
          {d.duracion_sesion ? (<><dt>Sessió</dt><dd>{d.duracion_sesion}</dd></>) : null}
          {d.numero_sesiones ? (<><dt>Sessions</dt><dd>{d.numero_sesiones}</dd></>) : null}
          {d.anestesia ? (<><dt>Anestèsia</dt><dd>{anestesias[d.anestesia]}</dd></>) : null}
        </dl>

        <div class="firma">
          <strong>{doctor?.data.nombre}</strong>
          {cargoCa}
          <span class="colegiado">Col. {doctor?.data.numero_colegiado}</span>
        </div>

        <a class="boton boton-verde cta" href={`https://wa.me/${clinica.whatsapp}?text=${encodeURIComponent('Hola, voldria informació sobre ' + d.titulo)}`} target="_blank" rel="noopener noreferrer">
          Preguntar per WhatsApp
        </a>
      </div>
    </aside>
    </div>
  </div>

  <Fragment slot="despues-contenido">
    <EquipoModulo idioma="ca" titulo="El nostre equip" />
  </Fragment>
</Base>
