---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import IntroAccion from '../../components/IntroAccion.astro';
import ReviewsModulo from '../../components/ReviewsModulo.astro';
import PorQueElegirnosModulo from '../../components/PorQueElegirnosModulo.astro';
import PrimeraVisitaModulo from '../../components/PrimeraVisitaModulo.astro';

const equipo = (await getCollection('equipo', (e) => !e.data.noindex)).sort(
  (a, b) => a.data.orden - b.data.orden
);
---
<Base
  titulo="Equipo — Doria Clinic"
  descripcion="El equipo de doctores y especialistas de Doria Clinic en el Eixample de Barcelona: formación, especialidad y trayectoria de cada uno."
  h1="Equipo"
  lede="Un equipo de especialistas, cada uno formado en su área, coordinados para cuidar tu salud bucodental de forma integral."
  imagenCabecera={{ src: '/img/instalaciones/03-pasillo-banco.jpg', alt: 'Equipo de Doria Clinic en el Eixample de Barcelona' }}
  introDosColumnas
  anchoDoble
>
  <Fragment slot="intro-acciones">
    <IntroAccion idioma="es" mensaje="Hola, quiero pedir cita" parte="acciones" />
  </Fragment>
  <Fragment slot="intro-razones">
    <IntroAccion idioma="es" mensaje="Hola, quiero pedir cita" parte="razones" />
  </Fragment>

  <div class="equipo">
    {equipo.map((doc) => (
      <a class="equipo-tarjeta" href={`/equipo/${doc.id}/`}>
        <figure>
          {doc.data.foto && <img src={doc.data.foto} alt={doc.data.nombre} loading="lazy" />}
          <figcaption>
            <span class="nombre">{doc.data.nombre}</span>
            <span class="puesto">{doc.data.cargo}</span>
            <span class="mas">Ver ficha →</span>
          </figcaption>
        </figure>
      </a>
    ))}
  </div>

  <Fragment slot="despues-contenido">
    <PrimeraVisitaModulo idioma="es" />
    <ReviewsModulo idioma="es" />
    <PorQueElegirnosModulo idioma="es" />
  </Fragment>
</Base>
